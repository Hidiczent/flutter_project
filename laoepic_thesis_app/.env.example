# Copy to `.env` (gitignored). Loaded at runtime via flutter_dotenv.
# Use the same Web Client ID as backend GOOGLE_CLIENT_ID / dashboard VITE_GOOGLE_CLIENT_ID.
#
GOOGLE_WEB_CLIENT_ID=498030919491-b5d1n1erpj11ga1ubnnlkdj68lt3a48g.apps.googleusercontent.com
#
# iPhone only — create "iOS" OAuth client in Google Cloud (bundle: com.example.flutterProject)
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Then run: bash tool/configure_google_ios.sh
#
# Optional — override default Railway backend:
# API_ORIGIN=http://127.0.0.1:5550
# API_ORIGIN=http://10.0.2.2:5550
#
# For --dart-define-from-file (must be JSON), copy dart_defines.example.json
# to dart_defines.json instead.
